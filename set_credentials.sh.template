#!/bin/bash
# Template for setting up Gmail API credentials
# Make a copy of this file as 'set_credentials.sh', add your credentials, and make it executable

# Google OAuth credentials (replace with your own values)
export GOOGLE_CLIENT_ID="YOUR_CLIENT_ID_HERE"
export GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"
export GOOGLE_REFRESH_TOKEN="YOUR_REFRESH_TOKEN_HERE"
export GOOGLE_ACCESS_TOKEN="YOUR_ACCESS_TOKEN_HERE"  # Optional, can be refreshed using the refresh token

# Instructions:
# 1. Copy this file: cp set_credentials.sh.template set_credentials.sh
# 2. Edit set_credentials.sh with your real credentials
# 3. Make executable: chmod +x set_credentials.sh
# 4. Run to set environment variables: source ./set_credentials.sh

echo "Google OAuth credentials set as environment variables."
